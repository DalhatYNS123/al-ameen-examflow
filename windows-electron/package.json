{
  "name": "alameen-examflow",
  "productName": "AL-AMEEN EXAMFLOW",
  "version": "3.5.6",
  "description": "The Intelligent Examination Paper Preparation System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.dynscore.alameenexamflow",
    "productName": "AL-AMEEN EXAMFLOW",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}